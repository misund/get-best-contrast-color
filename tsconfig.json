{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./build",
    "module": "node20",
    "moduleResolution": "node16",
    "target": "esnext",
		"lib": [
			"DOM",
			"ES2024" // Node.js 22
		],
    "declaration": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
		"exactOptionalPropertyTypes": true,
		"erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "test"]
}
